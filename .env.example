# PROFILER — environment configuration
#
# Copy this to `.env` and edit. The app reads `.env` automatically at startup;
# real environment variables always win over anything in the file.
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit it — it holds the password to your vault.
#
# On Vercel there is no .env file: set these in
# Settings -> Environment Variables instead.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED before you expose this to anything but localhost
# ─────────────────────────────────────────────────────────────────────────────

# The login password. The built-in default is public knowledge (it is in the
# source), so anyone who finds your URL is one guess from the credential vault.
# The app prints a warning at startup until you change this.
PROFILER_PASSWORD=change-me-to-something-long-and-unguessable

# Signs session cookies. Generate a real one:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Leaving this unset generates a new key on every start, which logs everyone
# out on restart and breaks sessions entirely across multiple workers.
SECRET_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# SERVER  (all optional)
# ─────────────────────────────────────────────────────────────────────────────

# Bind address and port for `python run.py`.
# Use 0.0.0.0 to accept connections from other machines — only do that once
# PROFILER_PASSWORD is set.
HOST=127.0.0.1
PORT=5000

# Never enable debug on anything reachable from a network: Flask's debugger
# executes arbitrary code from the browser.
FLASK_DEBUG=0

# Force the Secure flag on session cookies. Set this when you serve over HTTPS
# behind a proxy; it is switched on automatically on serverless hosts.
# FORCE_HTTPS=1

# Posts per page in the monitor list.
PAGE_SIZE=25

# Seconds a collection run may take before the client gives up.
# COLLECT_TIMEOUT=120


# ─────────────────────────────────────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────────────────────────────────────
#
# Your data — watches, posts, profiles, notes, photos, link maps — lives in the
# BROWSER (IndexedDB), not here. The server database only holds the built-in
# dork templates, the encrypted credential vault, and any copy you explicitly
# push with the sync endpoints.

# An external database instead of the local SQLite file. Only needed if you
# want vault credentials to survive restarts on a serverless host, or a shared
# sync target for several machines.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Where the SQLite file and the vault salt live. Defaults to ./instance
# PROFILER_INSTANCE_DIR=/var/lib/profiler

# Where uploaded files go. Defaults to app/static/uploads/profile_pics
# PROFILER_UPLOAD_DIR=/var/lib/profiler/uploads


# ─────────────────────────────────────────────────────────────────────────────
# CREDENTIAL VAULT
# ─────────────────────────────────────────────────────────────────────────────

# Unlocks the vault at startup so authenticated collection works without
# someone typing the passphrase into the UI first.
#
# This is a real trade-off: it means the key sits in the process environment,
# so anything that can read the environment can decrypt the stored cookies.
# On a shared or internet-facing host, prefer unlocking by hand.
# MONITOR_VAULT_KEY=your-vault-passphrase


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL SOURCE CREDENTIALS
# ─────────────────────────────────────────────────────────────────────────────
#
# Prefer the in-app Vault over these: it encrypts at rest, and the UI shows
# each credential's health. These exist for automated deployments where a
# manual unlock is impractical.

# Reddit (PRAW). A free app registered at reddit.com/prefs/apps.
# Lifts the datacenter-IP blocks that throttle anonymous access.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# X / Twitter. Requires a PAID API tier — there is no free search endpoint.
# TWITTER_BEARER_TOKEN=

# Telegram. From my.telegram.org. Without these, public channels still work
# through the web preview, just with less history.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL FEATURES
# ─────────────────────────────────────────────────────────────────────────────

# Enables the "second opinion from Claude" button on a scored post. The key
# stays server-side and is never sent to the browser.
# ANTHROPIC_API_KEY=

# A local MaxMind GeoLite2 database for offline IP geolocation: no rate limit,
# and no third party learns which addresses you are investigating.
# Download GeoLite2-City.mmdb (free account) and point this at it.
# Without it, geolocation falls back to ip-api.com.
# GEOIP_DB=/path/to/GeoLite2-City.mmdb
